# Origine publique du site (canonicals, og:image, JSON-LD, sitemap, robots).
# Optionnel en preview (VERCEL_URL est utilisé), obligatoire en prod si le
# domaine diffère de la valeur de repli dans lib/site-url.js.
NEXT_PUBLIC_SITE_URL=https://lumieredenoelinc.com

# Meta Pixel — activé automatiquement si présent (voir app/layout.jsx).
# Laisser vide pour désactiver le pixel.
NEXT_PUBLIC_META_PIXEL_ID=
