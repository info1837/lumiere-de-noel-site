{
  "name": "lumiere-de-noel-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "node --no-warnings scripts/check-photos.mjs && next build",
    "start": "next start",
    "check:photos": "node --no-warnings scripts/check-photos.mjs",
    "audit:visuel": "node scripts/audit-visuel.mjs",
    "audit:visuel:autotest": "node scripts/audit-visuel-autotest.mjs",
    "check:logo": "node scripts/check-logo.mjs",
    "check:menu": "node scripts/check-tiroir-mobile.mjs",
    "check:entete": "node scripts/check-entete-mobile.mjs",
    "check:calc": "node scripts/check-calculatrice.mjs && node --import ./scripts/next-alias-register.mjs scripts/check-ancrage-calculatrice.mjs",
    "check:utm": "node scripts/check-relais-utm.mjs",
    "check:utm-navigateur": "node scripts/check-utm-vers-crm.mjs",
    "check:sim": "node scripts/check-simulateur-ordre.mjs",
    "check:accueil": "node scripts/check-hero.mjs && node scripts/check-respiration.mjs && node scripts/check-credibilite.mjs && node scripts/check-moins-de-boutons.mjs",
    "check:saison": "node scripts/check-bandeau-rarete.mjs",
    "check:lead": "node scripts/check-lead-simulateur.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "vercel": "^51.6.1"
  }
}
